{
  "manifest_version": 3,
  "name": "StuHack",
  "version": "0.5.9",
  "description": "Banner remover, filter pass & document downloader",
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "content_scripts": [
    {
      "js": [
        "runtime.js",
        "remove-banner.js",
        "remove-blur.js",
        "doc-viewer.js"
      ],
      "css": [
        "style.css"
      ],
      "matches": [
        "https://studocu.com/*",
        "https://*.studocu.com/*",
        "https://studocu.vn/*",
        "https://*.studocu.vn/*",
        "https://studeersnel.nl/*",
        "https://*.studeersnel.nl/*"
      ],
      "run_at": "document_idle"
    }
  ]
}
